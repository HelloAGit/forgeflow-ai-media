# -----------------------------
# ForgeFlow AI Media - Example Environment
# -----------------------------
# IMPORTANT:
# - Do NOT commit real credentials.
# - B2_BUCKET must be the bucket NAME (not bucket ID).
# - B2_REGION must be a valid B2 S3 region code (example: eu-central-003).

# Genblaze / GMI
GMI_API_KEY=replace_me
GMI_BASE_URL=https://api.genblaze.ai

# Backblaze B2 (S3 compatible)
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET=your_bucket_name
B2_ACCESS_KEY_ID=replace_me
B2_SECRET_ACCESS_KEY=replace_me
