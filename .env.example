# Backblaze B2 Configuration (S3-compatible API)
# Get these credentials from https://secure.backblaze.com/app_keys.htm
B2_KEY_ID=your_b2_key_id_here
B2_APP_KEY=your_b2_app_key_here
B2_BUCKET=your_b2_bucket_id_here
B2_REGION=Europe

# GMI API Configuration
# Get this key from your GMI Console organization settings
GMI_API_KEY=your_gmi_api_key_here
