# Backblaze B2 Configuration (S3-compatible API)
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET=your_b2_bucket_name
B2_REGION=us-west-004

# Genblaze / GMI Cloud API Configuration
GMI_API_KEY=your_genblaze_api_key
GMI_BASE_URL=https://api.gmicloud.ai/v1
GMI_PIPELINE_ID=image-generation
GMI_TIMEOUT=120
