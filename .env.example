# Backblaze B2 Configuration (S3-compatible API)
# Key ID from the Backblaze B2 application key
B2_KEY_ID=your-b2-key-id-here
# Application key secret
B2_APP_KEY=your-b2-app-key-here
# Bucket *name* (not bucket ID), e.g. my-media-bucket
B2_BUCKET=your-bucket-name-here
# B2 S3-compatible region, format: <area>-<direction>-<NNN>  e.g. eu-central-003
B2_REGION=eu-central-003

# Genblaze / GMI API key
GMI_API_KEY=your-gmi-api-key-here
